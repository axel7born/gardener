;
; BIND data file for local.gardener.cloud
;
$TTL    30
@       IN      SOA     ns.local.gardener.cloud. admin.local.gardener.cloud. (
                     2026021101         ; Serial
                             30         ; Refresh
                             30         ; Retry
                             30         ; Expire
                              1 )       ; Negative Cache TTL

; Name Servers
@       IN      NS      ns.local.gardener.cloud.
ns      IN      A       172.18.0.2
ns      IN      AAAA    fd00:ff::53

; A records for registry containers using their stable bridge IPs (set via ipv4_address in docker-compose.yaml).
; Previously this used NS delegation to Docker's built-in DNS server (127.0.0.11), but Docker Desktop 4.77+
; returns only IPv6 addresses for container aliases resolved via that DNS, breaking IPv4-only containerd clients.
registry                              IN  A  172.18.0.3
gcr.registry-cache                    IN  A  172.18.0.4
k8s.registry-cache                    IN  A  172.18.0.5
quay.registry-cache                   IN  A  172.18.0.6
europe-docker-pkg-dev.registry-cache  IN  A  172.18.0.7

; The self-hosted shoot API server is accessible from the host machine via the gind Envoy load balancer.
; The loopback device for this IP is set up in 'dev-setup/infra.sh setup-loopback-devices'.
api.root.garden.external    IN  A       172.18.255.123
